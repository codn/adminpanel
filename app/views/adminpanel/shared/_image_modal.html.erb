<%= link_to image_tag(object.send("#{attribute}_url", :thumb)), "#modal_#{object.id}", role: "button", data: { toggle: 'modal' } %>
<div id="modal_<%= object.id %>"
  class="modal hide fade" tabindex="-1" role="dialog" aria-labelledby="modal_<%= object.id %>_Label" aria-hidden="true">
 <div class="modal-header">
  <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
  <h3><%= object.name %></h3>
</div>
<div class="modal-body">
  <%=image_tag(object.send("#{attribute}_url"), class: "img-modal")%>
</div>
<div class="modal-footer">
  <button class="btn" data-dismiss="modal" aria-hidden="true"><%= I18n.t("action.close")%></button>
</div>
</div>